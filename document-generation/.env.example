# Local configuration. Existing shared EAR_* settings work without overrides.
# EAR_GITHUB_TOKEN=
# EAR_B2_REGION=us-west-004
# EAR_B2_BUCKET=your-private-bucket
# EAR_B2_KEY_ID=
# EAR_B2_APPLICATION_KEY=

# Optional per-tool replacements. Supply each key ID and secret as a pair.
# EAR_DOCUMENT_GITHUB_TOKEN=
# EAR_DOCUMENT_B2_REGION=us-west-004
# EAR_DOCUMENT_B2_BUCKET=your-private-bucket
# EAR_DOCUMENT_B2_REQUEST_WRITE_KEY_ID=
# EAR_DOCUMENT_B2_REQUEST_WRITE_KEY=
# EAR_DOCUMENT_B2_OUTPUT_READ_KEY_ID=
# EAR_DOCUMENT_B2_OUTPUT_READ_KEY=
EAR_DOCUMENT_REPO=Kaycee7000/ear
EAR_DOCUMENT_REF=main
EAR_DOCUMENT_WORKFLOW=generate-document.yml
EAR_DOCUMENT_PREFIX=documents
# EAR_DOCUMENT_DB=/absolute/path/to/jobs.sqlite3
EAR_DOCUMENT_ACTIVE_LIMIT=1
EAR_DOCUMENT_DAILY_LIMIT=10
EAR_DOCUMENT_MAX_WAIT=20
EAR_DOCUMENT_TOOL_DEADLINE=30
EAR_DOCUMENT_URL_TTL=3600
